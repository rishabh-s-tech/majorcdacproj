# Copy this file to .env (same folder as docker-compose.yml) and fill in real values.
# .env is already gitignored - never commit real secrets.

# --- MySQL ---
DB_ROOT_PASSWORD=change_me_root_password
DB_USERNAME=greennest_app
DB_PASSWORD=change_me_app_password
DDL_AUTO=update
SHOW_SQL=false

# --- CORS (frontend origin as the browser sees it) ---
APP_CORS_ALLOWED_ORIGIN=http://localhost:5173

# --- JWT --- generate a real random value, e.g.: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRATION_MS=86400000

# --- Default admin account seeded on first startup ---
APP_ADMIN_EMAIL=admin@greennest.com
APP_ADMIN_PASSWORD=change_me_admin_password

# --- Frontend build-time API URL (baked into the JS bundle at image build) ---
VITE_API_BASE_URL=http://localhost:8080/api
